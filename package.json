{
  "name": "tech-passport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal technology record and recovery planner",
  "author": "Greg Weir <gweir@tartanleaf.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gregweir/tech-passport.git"
  },
  "homepage": "https://techpassport.tartanleaf.com",
  "bugs": {
    "url": "https://github.com/gregweir/tech-passport/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8080 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t tech-passport .",
    "docker:run": "docker run --rm -p 8080:8080 tech-passport"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.46.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "idb": "^8.0.0"
  }
}
